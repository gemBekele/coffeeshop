// Coffee House Management System - Prisma schema
// Single shop now; all models carry shopId so multi-branch is a later addition.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  BARISTA
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  VOID
}

enum PaymentSource {
  SMS
  MANUAL
  OCR
  NOTIFICATION
}

enum PaymentStatus {
  UNMATCHED
  MATCHED
  VERIFIED
  DUPLICATE
  REJECTED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  WASTE
  SALE
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SmsProvider {
  TELEBIRR
  CBE_BIRR
  AMOLE
  AWASH
  OTHER
}

enum TemplateDirection {
  CREDIT
  DEBIT
}

enum ScanStatus {
  PENDING
  MATCHED
}

model Shop {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  address         String?
  currency        String   @default("ETB")
  timezone        String   @default("Africa/Addis_Ababa")
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  /// Incoming transfers above this amount are not auto-picked as payments.
  paymentMaxAmount Decimal @default(1000) @db.Decimal(12, 2)
  publicMenuSlug  String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff            Staff[]
  shifts           Shift[]
  devices          Device[]
  categories       Category[]
  products         Product[]
  inventoryItems   InventoryItem[]
  stockMovements   StockMovement[]
  orders           Order[]
  payments         Payment[]
  pendingPayments  PendingPayment[]
  templates        SmsTemplate[]
  unmatchedSms     UnmatchedSms[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  pairings         StaffPairing[]
  paymentScans     PaymentScan[]
}

model StaffPairing {
  id         String    @id @default(cuid())
  shopId     String
  staffId    String
  deviceId   String?
  /// Short human code the employee reads out / the owner confirms.
  code       String    @unique
  /// Secret embedded in the QR code. Single-use, short lived.
  token      String    @unique
  status     String    @default("PENDING") // PENDING | APPROVED | DENIED | EXPIRED
  expiresAt  DateTime
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff  Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([staffId])
  @@index([status])
  @@index([expiresAt])
}

model Staff {
  id           String    @id @default(cuid())
  shopId       String
  fullName     String
  email        String?   @unique
  phone        String?   @unique
  employeeCode String?   @unique
  role         StaffRole @default(BARISTA)
  passwordHash String?
  pinHash      String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shop             Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shifts           Shift[]
  devices          Device[]
  ordersCreated    Order[]
  orderEvents      OrderStatusEvent[]
  templatesCreated SmsTemplate[]
  templateRevisions SmsTemplateRevision[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  pairings         StaffPairing[]
  paymentScans     PaymentScan[]

  @@index([shopId])
  @@index([role])
  @@index([isActive])
}

model Shift {
  id            String      @id @default(cuid())
  shopId        String
  staffId       String
  status        ShiftStatus @default(OPEN)
  openingFloat  Decimal     @default(0) @db.Decimal(12, 2)
  closingCash   Decimal?    @db.Decimal(12, 2)
  expectedCash  Decimal?    @db.Decimal(12, 2)
  difference    Decimal?    @db.Decimal(12, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff  Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([shopId])
  @@index([staffId])
  @@index([status])
  @@index([openedAt])
}

model Device {
  id           String         @id @default(cuid())
  shopId       String
  staffId      String?
  label        String
  role         StaffRole      @default(OWNER)
  platform     DevicePlatform @default(ANDROID)
  apiKeyHash   String         @unique
  apiKeyPrefix String
  lastSeenAt   DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff      Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  payments   Payment[]
  unmatchedSms UnmatchedSms[]
  pairings   StaffPairing[]

  @@index([shopId])
  @@index([staffId])
  @@index([isActive])
}

model Category {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id             String   @id @default(cuid())
  shopId         String
  categoryId     String?
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  imageUrl       String?
  trackInventory Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category          Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  recipeIngredients RecipeIngredient[]
  orderItems        OrderItem[]

  @@index([shopId])
  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  priceDelta Decimal  @default(0) @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  productId       String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(12, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryItemId])
  @@index([productId])
  @@index([inventoryItemId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  shopId       String
  name         String
  unit         String   @default("pcs")
  stockOnHand  Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(14, 3)
  cost         Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  movements         StockMovement[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([isActive])
}

model StockMovement {
  id              String            @id @default(cuid())
  shopId          String
  inventoryItemId String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  reason          String?
  refOrderId      String?
  createdById     String?
  createdAt       DateTime          @default(now())

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [refOrderId], references: [id], onDelete: SetNull)
  createdBy     Staff?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([inventoryItemId])
  @@index([refOrderId])
  @@index([createdAt])
}

model Order {
  id             String      @id @default(cuid())
  shopId         String
  orderNumber    Int
  type           OrderType   @default(DINE_IN)
  status         OrderStatus @default(OPEN)
  tableLabel     String?
  customerName   String?
  customerPhone  String?
  customerTxnId  String?
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  tax            Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  note           String?
  shiftId        String?
  createdById    String?
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shift         Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy     Staff?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
  payments      Payment[]
  pendingPayments PendingPayment[]
  stockMovements StockMovement[]

  @@unique([shopId, orderNumber])
  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@index([customerTxnId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  nameSnapshot String
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int      @default(1)
  lineTotal    Decimal  @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy Staff? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id             String          @id @default(cuid())
  shopId         String
  orderId        String?
  txnId          String
  referenceTxnId String?
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("ETB")
  sender         String?
  senderPhone    String?
  bank           String?
  provider       SmsProvider?
  direction      TemplateDirection @default(CREDIT)
  rawSms         String          @db.Text
  source         PaymentSource   @default(SMS)
  status         PaymentStatus   @default(UNMATCHED)
  /// Picked up automatically; staff must confirm it is a real payment.
  confirmed      Boolean         @default(false)
  confirmedAt    DateTime?
  deviceId       String?
  templateId     String?
  receivedAt     DateTime        @default(now())
  matchedAt      DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime        @default(now())

  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order    Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  device   Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  template SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scans    PaymentScan[]

  @@unique([shopId, txnId])
  @@index([shopId])
  @@index([orderId])
  @@index([status])
  @@index([receivedAt])
  @@index([shopId, receivedAt])
  @@index([shopId, status])
  @@index([amount])
}

model PendingPayment {
  id        String   @id @default(cuid())
  shopId    String
  orderId   String?
  txnId     String
  amount    Decimal? @db.Decimal(12, 2)
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([txnId])
  @@index([expiresAt])
}

model SmsTemplate {
  id              String            @id @default(cuid())
  shopId          String
  name            String
  provider        SmsProvider       @default(OTHER)
  senderAllowlist String[]
  templateBody    String            @db.Text
  direction       TemplateDirection @default(CREDIT)
  status          TemplateStatus    @default(DRAFT)
  version         Int               @default(1)
  sampleSms       String?           @db.Text
  fieldMap        Json?
  lastTestedAt    DateTime?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  shop       Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy  Staff?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revisions  SmsTemplateRevision[]
  payments   Payment[]

  @@index([shopId])
  @@index([status])
  @@index([provider])
}

model SmsTemplateRevision {
  id              String            @id @default(cuid())
  templateId      String
  version         Int
  templateBody    String            @db.Text
  direction       TemplateDirection
  senderAllowlist String[]
  changedById     String?
  createdAt       DateTime          @default(now())

  template  SmsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  changedBy Staff?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@index([templateId])
}

model UnmatchedSms {
  id         String   @id @default(cuid())
  shopId     String
  deviceId   String?
  sender     String?
  body       String   @db.Text
  receivedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([resolvedAt])
  @@index([shopId, receivedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  shopId    String?
  staffId   String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  shop  Shop?  @relation(fields: [shopId], references: [id], onDelete: SetNull)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([staffId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  shopId    String
  staffId   String?
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([shopId, isRead])
  @@index([createdAt])
}

/// An OCR scan of a payer's payment screen. Stored immediately so it can be
/// confirmed later, even if the matching SMS has not arrived yet.
model PaymentScan {
  id        String     @id @default(cuid())
  shopId    String
  staffId   String?
  txnId     String?
  amount    Decimal?   @db.Decimal(12, 2)
  sender    String?
  rawText   String     @db.Text
  status    ScanStatus @default(PENDING)
  paymentId String?
  createdAt DateTime   @default(now())
  matchedAt DateTime?

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([paymentId])
}

/// Durable fallback for the shared key/value store (refresh-token registry)
/// when Redis is unavailable, so restarts do not force users to log in again.
model KvEntry {
  key       String   @id
  value     String
  expiresAt DateTime

  @@index([expiresAt])
}

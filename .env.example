# ------------------------------------------------------------------
# Coffee House Management System - environment
# Copy to .env and adjust.
# ------------------------------------------------------------------

# --- API ---
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://coffeeshop:coffeeshop@localhost:5432/coffeeshop?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STAFF_PIN_PEPPER=change-me-pin-pepper

# --- Devices / SMS ingest ---
DEVICE_API_KEY_PREFIX=csd_

# --- Public web menu ---
NEXT_PUBLIC_API_URL=http://localhost:4000
